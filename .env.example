# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Нужен для seed-скрипта и для /admin (никогда не коммить и не класть в NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Пароль входа в приватную аналитику /admin — придумай свой, не используй пример
ADMIN_PASSWORD=change-me
# Случайная строка для подписи сессионной куки — сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too
